# Public Firebase Web app configuration for the already-approved project:
# ethereal-throne-b20e6
# These are client configuration values, not service-account credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=ethereal-throne-b20e6
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Public reCAPTCHA Enterprise site key registered for Firebase App Check.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Keep false until the merged production Firestore rules and App Check token
# exchange have both been reviewed and verified.
VITE_FIRESTORE_CLIENT_ACCESS_APPROVED=false

# Keep false until Firebase AI authenticated-users mode, App Check enforcement,
# project quotas, privacy terms, and a cost-quoted backend request path are verified.
VITE_FIREBASE_AI_PROJECT_SECURITY_CONFIRMED=false
