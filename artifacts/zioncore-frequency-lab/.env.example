# Public Firebase Web app configuration for the already-approved project:
# ethereal-throne-b20e6
# These are client configuration values, not service-account credentials.
# In Replit, set the development and production Firebase web app configuration
# in their matching environments; do not put App Check keys in shared scope.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=ethereal-throne-b20e6
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Public reCAPTCHA Enterprise site key registered for Firebase App Check.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Keep Firestore client access off until approved rules are deployed and verified.
VITE_FIRESTORE_CLIENT_ACCESS_APPROVED=false
