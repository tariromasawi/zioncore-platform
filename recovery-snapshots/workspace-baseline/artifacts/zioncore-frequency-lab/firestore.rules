rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The inspected live rules contained a project-wide allow-all grant and
    // six explicitly public legacy roots. Unclassified roots default deny.
    function ownsUserPath(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validPeak(peaks, index, nyquist) {
      return peaks.size() <= index
        || (peaks[index] is number && peaks[index] > 0 && peaks[index] <= nyquist);
    }

    function validInterpretationSource(sources, index) {
      return sources.size() <= index
        || (sources[index] is string
          && sources[index].size() > 0
          && sources[index].size() <= 240);
    }

    function validInterpretationProvenance(provenance, observationId, modelId) {
      return provenance is map
        && provenance.keys().hasAll(['source', 'observationId', 'modelId'])
        && provenance.keys().hasOnly([
          'source',
          'observationId',
          'methodId',
          'methodVersion',
          'promptVersion',
          'provider',
          'modelId',
          'generatedAt'
        ])
        && provenance.source == 'ai-generated'
        && provenance.observationId == observationId
        && provenance.modelId == modelId;
    }

    function validInterpretation(interpretation, observationId) {
      return interpretation is map
        && interpretation.keys().hasAll([
          'scientificInterpretation',
          'confidence',
          'uncertainty',
          'possibleSources',
          'faithReflection',
           'model'
        ])
        && interpretation.keys().hasOnly([
          'scientificInterpretation',
          'confidence',
          'uncertainty',
          'possibleSources',
          'faithReflection',
          'model',
          'provenance'
        ])
        && interpretation.scientificInterpretation is string
        && interpretation.scientificInterpretation.size() > 0
        && interpretation.scientificInterpretation.size() <= 1800
        && interpretation.confidence in ['low', 'moderate', 'high']
        && interpretation.uncertainty is string
        && interpretation.uncertainty.size() > 0
        && interpretation.uncertainty.size() <= 1200
        && interpretation.possibleSources is list
        && interpretation.possibleSources.size() <= 6
        && validInterpretationSource(interpretation.possibleSources, 0)
        && validInterpretationSource(interpretation.possibleSources, 1)
        && validInterpretationSource(interpretation.possibleSources, 2)
        && validInterpretationSource(interpretation.possibleSources, 3)
        && validInterpretationSource(interpretation.possibleSources, 4)
        && validInterpretationSource(interpretation.possibleSources, 5)
        && (interpretation.faithReflection == null
          || (interpretation.faithReflection is string
            && interpretation.faithReflection.size() <= 900))
        && interpretation.model is string
        && interpretation.model.size() > 0
        && interpretation.model.size() <= 100
        && (!interpretation.keys().hasAny(['provenance'])
          || validInterpretationProvenance(
            interpretation.provenance,
            observationId,
            interpretation.model
          ));
    }

    function validInstrumentProvenance(provenance) {
      return provenance is map
        && provenance.keys().hasOnly([
          'instrumentId',
          'instrumentName',
          'acquisitionMethod',
          'physicalDeviceIdentity',
          'inputChannels',
          'units',
          'calibration',
          'softwareVersion'
        ])
        && provenance.instrumentId is string
        && provenance.instrumentId.size() <= 120
        && provenance.instrumentName is string
        && provenance.instrumentName.size() <= 120
        && provenance.acquisitionMethod in ['browser-microphone', 'local-wav-file']
        && provenance.physicalDeviceIdentity == 'not-collected'
        && provenance.units is map
        && provenance.units.keys().hasOnly([
          'frequency',
          'frequencyResolution',
          'amplitude',
          'duration'
        ])
        && provenance.units.frequency == 'Hz'
        && provenance.units.frequencyResolution == 'Hz'
        && provenance.units.amplitude == 'FS'
        && provenance.units.duration == 'seconds'
        && provenance.calibration is map
        && provenance.calibration.keys().hasOnly(['status', 'checkedAt', 'reference'])
        && provenance.calibration.status in [
          'not-applicable',
          'uncalibrated',
          'user-calibrated',
          'factory-calibrated'
        ]
        && (provenance.calibration.checkedAt == null
          || (provenance.calibration.checkedAt is string
            && provenance.calibration.checkedAt.size() <= 40))
        && provenance.calibration.reference is string
        && provenance.calibration.reference.size() <= 240
        && provenance.softwareVersion is string
        && provenance.softwareVersion.size() <= 160;
    }

    function validObservation(data, observationId) {
      return data.keys().hasAll([
          'createdAt',
          'updatedAt',
          'sampleRate',
          'fftSize',
          'frequencyResolutionHz',
          'dominantFrequencyHz',
          'topPeaksHz',
          'rmsLevel',
          'durationSeconds',
          'mode'
        ])
        && data.keys().hasOnly([
          'createdAt',
          'updatedAt',
          'sampleRate',
          'fftSize',
          'frequencyResolutionHz',
          'dominantFrequencyHz',
          'topPeaksHz',
          'rmsLevel',
          'durationSeconds',
          'mode',
          'notes',
          'interpretation',
          'instrumentProvenance'
        ])
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && data.sampleRate is int
        && data.sampleRate >= 8000
        && data.sampleRate <= 192000
        && data.fftSize in [2048, 4096, 8192]
        && data.frequencyResolutionHz is number
        && data.frequencyResolutionHz > 0
        && data.frequencyResolutionHz == data.sampleRate * 1.0 / data.fftSize
        && (data.dominantFrequencyHz == null
          || (data.dominantFrequencyHz is number
            && data.dominantFrequencyHz > 0
            && data.dominantFrequencyHz <= data.sampleRate * 1.0 / 2))
        && data.topPeaksHz is list
        && data.topPeaksHz.size() <= 6
        && validPeak(data.topPeaksHz, 0, data.sampleRate * 1.0 / 2)
        && validPeak(data.topPeaksHz, 1, data.sampleRate * 1.0 / 2)
        && validPeak(data.topPeaksHz, 2, data.sampleRate * 1.0 / 2)
        && validPeak(data.topPeaksHz, 3, data.sampleRate * 1.0 / 2)
        && validPeak(data.topPeaksHz, 4, data.sampleRate * 1.0 / 2)
        && validPeak(data.topPeaksHz, 5, data.sampleRate * 1.0 / 2)
        && data.rmsLevel is number
        && data.rmsLevel >= 0
        && data.rmsLevel <= 1
        && data.durationSeconds is number
        && data.durationSeconds >= 0
        && data.durationSeconds <= 86400
        && data.mode in ['microphone', 'audio-file']
        && (!data.keys().hasAny(['notes'])
          || (data.notes is string && data.notes.size() <= 4000))
        && (!data.keys().hasAny(['interpretation'])
          || validInterpretation(data.interpretation, observationId))
        && (!data.keys().hasAny(['instrumentProvenance'])
          || validInstrumentProvenance(data.instrumentProvenance));
    }

    match /users/{uid}/frequency_observations/{observationId} {
      // Browser deletion stays denied until an authenticated server endpoint
      // can authorize and record the deletion audit event. Trusted server
      // access is governed by IAM, not these client rules.
      allow get, list: if ownsUserPath(uid);
      allow create: if ownsUserPath(uid) && validObservation(request.resource.data, observationId);
      allow update: if ownsUserPath(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['interpretation', 'updatedAt'])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['interpretation'])
        && request.resource.data.keys().hasAny(['interpretation'])
        && request.resource.data.updatedAt == request.time
        && validInterpretation(request.resource.data.interpretation, observationId);
    }
  }
}
