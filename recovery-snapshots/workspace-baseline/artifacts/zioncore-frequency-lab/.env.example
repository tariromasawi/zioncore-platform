# Public Firebase Web app configuration for the already-approved project:
# ethereal-throne-b20e6
# These are client configuration values, not service-account credentials.
# In Replit, set the development and production Firebase web app configuration
# in their matching environments; do not put App Check keys in shared scope.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=ethereal-throne-b20e6
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Public reCAPTCHA Enterprise site key registered for Firebase App Check.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Keep cloud AI paused until the Firebase project owner verifies authenticated-users
# mode, App Check enforcement, and an appropriate project-level quota.
# This flag is an app readiness gate, not a substitute for those server-side settings.
VITE_FIREBASE_AI_PROJECT_SECURITY_CONFIRMED=false

# Optional local-only Authentication Emulator endpoint for development tests.
# When set, use a demo-* project ID and fake public web config values.
# Keep empty in production and never point this at a non-local host.
VITE_FIREBASE_AUTH_EMULATOR_URL=

# Keep Firestore client access off until approved rules are deployed and verified.
VITE_FIRESTORE_CLIENT_ACCESS_APPROVED=false
